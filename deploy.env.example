# Copy this file to deploy.env and fill in the values for your own Nextcloud instance.
# deploy.env is gitignored - never commit real values there.
#
# See CLAUDE.md's "registered live and verified end-to-end" section for how these were
# discovered/chosen on the original homelab this app was built against, and README.md for a
# shorter version of the same recipe.

# --- Required ---

# Your Nextcloud instance's public URL, reachable from wherever you run `make`.
NC_URL=https://cloud.example.com

# Absolute host path to a directory holding HaRP's FRP client certs (client.crt/client.key/ca.crt).
# HaRP generates its own bundle on first boot - find yours with:
#   docker inspect appapi-harp   (look for its cert volume under "Mounts")
HARP_CERTS_DIR=/path/to/your/harp/certs/frp

# Regenerate for real use: `openssl rand -hex 24`. Never commit a real secret.
APP_SECRET=changeme-generate-your-own

# --- Optional - sensible defaults live in the Makefile, only set these if yours differ ---

# Name of the running Nextcloud container (occ commands run via `docker exec` into this).
# NC_CONTAINER=nextcloud-app-1

# Docker network shared by Nextcloud, appapi-harp, and this app's container.
# DOCKER_NETWORK=gateway

# Name to register the manual-install AppAPI daemon config under.
# DAEMON_NAME=manual_install_harp

# appapi-harp's own proxy address:port (used at daemon-register time) and FRP tunnel
# address:port (used when starting this app's container).
# HARP_HOST=appapi-harp:8780
# HARP_FRP_ADDRESS=appapi-harp:8782

# Must fall inside one of HaRP's frps.toml allowPorts ranges - check
# `docker exec appapi-harp cat /run/harp/frps.toml` on your instance before picking one.
# APP_PORT=23001
