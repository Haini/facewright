<?xml version="1.0"?>
<info>
	<id>facewright_bridge</id>
	<name>Facewright Bridge</name>
	<summary>Bridges Facewright's InsightFace ExApp detections into Recognize's database tables</summary>
	<description>
	<![CDATA[A thin, regular Nextcloud PHP app. Not an ExApp itself - it exists only because
ExApps have no path to real database access. It calls the facewright ExApp for face detection
and writes the results into Recognize's own oc_recognize_face_detections table via Nextcloud's
QueryBuilder, since only first-party PHP code can do that.]]>
	</description>
	<version>0.7.14</version>
	<licence>agpl</licence>
	<author>Constantin Schieber-Knoebl</author>
	<namespace>FacewrightBridge</namespace>
	<category>multimedia</category>
	<dependencies>
		<nextcloud min-version="33" max-version="35"/>
	</dependencies>
	<commands>
		<command>OCA\FacewrightBridge\Command\DetectFaces</command>
		<command>OCA\FacewrightBridge\Command\ClusterFaces</command>
		<command>OCA\FacewrightBridge\Command\ResetFacewrightData</command>
		<command>OCA\FacewrightBridge\Command\ScanLibrary</command>
		<command>OCA\FacewrightBridge\Command\ClusterScan</command>
		<command>OCA\FacewrightBridge\Command\MergeClusters</command>
		<command>OCA\FacewrightBridge\Command\BackfillAccess</command>
		<command>OCA\FacewrightBridge\Command\InitUserSettings</command>
		<command>OCA\FacewrightBridge\Command\CompactVectors</command>
		<command>OCA\FacewrightBridge\Command\ReopenUnassigned</command>
		<command>OCA\FacewrightBridge\Command\People</command>
		<command>OCA\FacewrightBridge\Command\MigrateFaces</command>
	</commands>
	<!-- app-info.xsd declares <settings> as an xs:sequence: admin, admin-section, personal,
	     personal-section. Reordering these makes the app info fail to parse. -->
	<settings>
		<admin>OCA\FacewrightBridge\Settings\AdminSettings</admin>
		<admin-section>OCA\FacewrightBridge\Settings\AdminSection</admin-section>
		<personal>OCA\FacewrightBridge\Settings\PersonalSettings</personal>
		<personal-section>OCA\FacewrightBridge\Settings\PersonalSection</personal-section>
	</settings>
	<navigations>
		<navigation>
			<name>People</name>
			<route>facewright_bridge.page.index</route>
			<icon>app.svg</icon>
			<order>8</order>
		</navigation>
	</navigations>
	<background-jobs>
		<job>OCA\FacewrightBridge\BackgroundJob\ClusteringMaintenanceJob</job>
		<job>OCA\FacewrightBridge\BackgroundJob\DetectionMaintenanceJob</job>
	</background-jobs>
</info>
